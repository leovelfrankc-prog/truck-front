<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Truckero Front</title>

    <link rel="manifest" href="manifest.json">
</head>
<body>
    <h1>Truckero Front</h1>
    <p>Frontend funcionando desde GitHub Pages.</p>

    <button onclick="probarFetch()">Probar fetch → doPost</button>

    <script>
        async function probarFetch() {
            const res = await fetch("https://script.google.com/macros/s/AKfycbXXXXXXX/exec", {
                method: "POST",
                body: JSON.stringify({ mensaje: "Hola desde GitHub Pages" })
            });

            const json = await res.json();
            console.log(json);
            alert(JSON.stringify(json));
        }
    </script>

    <script>
        if ("serviceWorker" in navigator) {
            navigator.serviceWorker.register("sw.js");
        }
    </script>
</body>
</html>
